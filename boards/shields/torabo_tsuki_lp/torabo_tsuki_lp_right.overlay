#include "torabo_tsuki_lp.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

&zip_temp_layer {
    // タイピング直後150msはポインタ移動でマウスレイヤーを起動しない（誤爆防止）
    require-prior-idle-ms = <150>;
};

&pointing_listener {
    // ポインタ移動でlayer_1を自動有効化し、750ms無操作で自動解除（オートマウスレイヤー）
    input-processors =
        <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>,
        <&zip_temp_layer 1 750>;

    // layer_4 が有効な間だけ、移動を1/6に減速してスクロールへ変換（ホールド式スクロール）
    scroller {
        layers = <4>;
        input-processors = <&zip_xy_scaler 1 6>, <&zip_xy_to_scroll_mapper>;
    };
};

&size_s_transform {
    col-offset = <7>;
};

&size_m_transform {
    col-offset = <7>;
};

&size_l_transform {
    col-offset = <7>;
};