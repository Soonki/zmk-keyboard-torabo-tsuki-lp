#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&sl {
    // ワンショットレイヤーは次の通常キー入力まで維持（時間による自動解除なし）
    release-after-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <13 14>;
            layers = <2>;
        };

        // === マウス操作コンボ（右手ホームロー隣接） ===
        // timeout-ms を短く、require-prior-idle-ms でタイピング直後の誤爆を防止

        // 左クリック：J + K
        combo_lclk {
            bindings = <&mkp LCLK>;
            key-positions = <16 17>;
            timeout-ms = <40>;
            require-prior-idle-ms = <125>;
        };

        // 右クリック：K + L
        combo_rclk {
            bindings = <&mkp RCLK>;
            key-positions = <17 18>;
            timeout-ms = <40>;
            require-prior-idle-ms = <125>;
        };

        // ワンショットスクロール：L + ; をタップして有効化、次の通常キー入力で解除
        combo_scroll {
            bindings = <&sl 4>;
            key-positions = <18 19>;
            timeout-ms = <50>;
            require-prior-idle-ms = <125>;
        };

        // 戻る（MB4）：H + J
        combo_back {
            bindings = <&mkp MB4>;
            key-positions = <15 16>;
            timeout-ms = <40>;
            require-prior-idle-ms = <125>;
        };

        // 進む（MB5）：, + .
        combo_fwd {
            bindings = <&mkp MB5>;
            key-positions = <29 30>;
            timeout-ms = <40>;
            require-prior-idle-ms = <125>;
        };

    };

    macros {
        compatible = "zmk,macros";

        // "LGTM!!" を一発入力（US配列：Shift押しっぱなしで l g t m 1 1）
        lgtm: lgtm {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings
                = <&macro_press &kp LSHFT>
                , <&macro_tap &kp L &kp G &kp T &kp M &kp N1 &kp N1>
                , <&macro_release &kp LSHFT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
                &kp ESC   &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp BSPC
                &kp TAB   &kp Q     &kp W     &kp E     &kp R     &kp T     &kp Y     &kp U     &kp I     &kp O     &kp P     &kp BSPC
                &kp CAPS   &kp A      &kp S      &kp D      &kp F      &kp G      &mkp LCLK  &mkp RCLK  &kp H      &kp J      &kp K      &kp L      &kp SEMI   &kp SQT
                &kp LSHFT       &kp Z           &kp X           &kp C           &kp V           &kp B           &kp SPACE       &kp ENTER       &kp N           &kp M           &kp COMMA       &kp DOT         &mt RSHFT FSLH  &kp RSHFT
                &kp LCTRL            &kp LCTRL            &kp LGUI             &kp LALT             &kp BSPC             &lt 2 SPACE          &mt LSHFT LC(SPACE)  &lt 2 RC(SPACE)  &lt 3 ENTER          &kp BSPC             &kp RALT             &kp RGUI             &kp RCTRL            &kp RCTRL
            >;
        };

        layer_1 {
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_2 {
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans      &kp LS(N1)  &kp LS(N2)  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)  &kp LS(N6)  &kp LS(N7)  &kp LS(N8)  &kp LS(N9)  &kp LS(N0)  &trans
                &trans  &kp N1  &kp N2  &kp N3  &kp N0  &trans  &trans  &trans  &kp LS(LBKT)  &kp MINUS  &kp EQUAL  &kp LS(RBKT)  &kp LS(SEMI)  &trans
                &trans  &kp N4  &kp N5  &kp N6  &trans  &trans  &trans  &lgtm  &kp LS(MINUS)  &kp LS(EQUAL)  &kp LBKT  &kp RBKT  &kp BSLH  &trans
                &trans  &kp N7  &kp N8  &kp N9  &trans  &trans  &trans  &trans  &kp TAB  &kp DEL  &trans  &trans  &trans  &trans
            >;
        };

        layer_3 {
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans     &kp F1     &kp F2     &kp F3     &kp F4     &kp F5     &kp HOME   &kp PG_UP  &kp PG_DN  &kp END    &kp ESC    &trans
                &trans     &kp F6     &kp F7     &kp F8     &kp F9     &kp F10    &trans     &trans     &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &kp TAB    &trans
                &trans         &kp F11        &kp F12        &out OUT_USB   &out OUT_BLE   &bt BT_NXT     &bt BT_CLR     &trans         &kp SQT        &kp LS(SQT)    &kp GRAVE      &kp LS(GRAVE)  &kp LS(BSLH)   &trans
                &trans   &trans   &trans   &trans   &kp DEL  &kp TAB  &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
            >;
        };

        layer_4 {
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

    };
};
